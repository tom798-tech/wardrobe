{
  "name": "wardrobe-front-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "管理端前端 - Vite + Vue 3.5 + TypeScript + Element Plus + Pinia",
  "scripts": {
    "dev": "vite --port 7077 --host",
