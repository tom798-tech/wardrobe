    "axios": "1.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.3",
    "typescript": "5.6.3",
    "vue-tsc": "2.2.10",
    "vite": "6.0.11",
    "@types/node": "22.10.10"
  }
}
